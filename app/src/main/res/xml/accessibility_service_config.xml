<?xml version="1.0" encoding="utf-8"?>
<!--
  Arquivo de compatibilidade para repositorios que receberam a v0.6.0 por upload.
  A v1.0.1 NAO registra AccessibilityService no AndroidManifest e NAO usa este recurso.
  Ele permanece apenas para sobrescrever o XML antigo e evitar erro do AAPT em uploads
  que nao removem automaticamente arquivos antigos do GitHub.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/app_name"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false" />
